<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Logistica.UI</RootNamespace>
    <AssemblyName>LogisticaFacturacion</AssemblyName>
    <Product>Sistema de Procesamiento y Auditoría de Facturación</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logistica.Dominio\Logistica.Dominio.csproj" />
    <ProjectReference Include="..\Logistica.Logica\Logistica.Logica.csproj" />
    <ProjectReference Include="..\Logistica.Persistencia\Logistica.Persistencia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RF1: el archivo de configuración se copia junto al ejecutable. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
